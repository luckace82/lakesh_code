# Lakesh Configuration
# Copy this file to .env and adjust settings as needed

# Mode: "agent" (reads files, uses tools) or "chat" (model only, no tools)
# Default: agent
LAKESH_MODE=agent

# Agent name (used in system prompts)
# Default: Lakesh
LAKESH_AGENT_NAME=Lakesh

# Ollama model to use
# Default: qwen3-coder:30b
LAKESH_MODEL=qwen3-coder:30b

# Server port (for lakesh_server.py)
# Default: 8765
LAKESH_PORT=8765

# Maximum agent steps before timeout
# Default: 50
LAKESH_MAX_STEPS=50
